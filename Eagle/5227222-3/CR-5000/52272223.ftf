(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c150.9
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 75450
            (pt 0 0)
          )
        )
      )
      (pad c104.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 52250
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c150.9h97
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 48500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c150.9))
          (noconnect (pad c150.9))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c150.9))
          (noconnect (pad c150.9))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c150.9))
          (noconnect (pad c150.9))
        )
        (padSet (footLayer Inner)
          (clearance (pad c150.9))
          (connect (pad c150.9))
          (noconnect (pad c150.9))
        )
        (padSet (footLayer Bottom)
          (connect (pad c150.9))
          (noconnect (pad c150.9))
        )
      )
      (padstack c104.5h209
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 104500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c104.5))
          (noconnect (pad c104.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c104.5))
          (noconnect (pad c104.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c104.5))
          (noconnect (pad c104.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c104.5))
          (connect (pad c104.5))
          (noconnect (pad c104.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c104.5))
          (noconnect (pad c104.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "52272223"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -738000 -856000
                        (width 20000)
                      )
                      (pt 738000 -856000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 738000 -856000
                        (width 20000)
                      )
                      (pt 738000 732000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 738000 732000
                        (width 20000)
                      )
                      (pt -738000 732000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -738000 732000
                        (width 20000)
                      )
                      (pt -738000 -856000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -738000 732000
                        (width 10000)
                      )
                      (pt 738000 732000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 738000 732000
                        (width 10000)
                      )
                      (pt 738000 -856000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 738000 -856000
                        (width 10000)
                      )
                      (pt -738000 -856000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -738000 -856000
                        (width 10000)
                      )
                      (pt -738000 732000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 838000 935000)
                    (pt 838000 -956000)
                    (pt -838000 -956000)
                    (pt -838000 935000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -10000 830000
                        (width 20000)
                      )
                      (pt -10000 830000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -10000 830000
                            (width 20000)
                          )
                        )
                        (center 1073741824 -0)
                        (end
                          (pt 0 830000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 830000
                            (width 20000)
                          )
                        )
                        (center -1073741824 -0)
                        (end
                          (pt -10000 830000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -10000 830000
                            (width 20000)
                          )
                        )
                        (center 1073741824 -0)
                        (end
                          (pt 0 830000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack c150.9h97))
                )
              )
            )
          )
          (pin 2
            (pt -254000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -254000 0)
                  (angle 90)
                  (padstackGroup default (padstack c150.9h97))
                )
              )
            )
          )
          (pin 3
            (pt 508000 508000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 508000 508000)
                  (angle 90)
                  (padstackGroup default (padstack c104.5h209))
                )
              )
            )
          )
          (pin 4
            (pt -508000 -508000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -508000 -508000)
                  (angle 90)
                  (padstackGroup default (padstack c104.5h209))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape 5227222-3.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

