Quaternion_set call:[assert]
Quaternion_setIdentity call:[Quaternion_set,assert] noreturn:[Quaternion_set]
Quaternion_copy call:[Quaternion_set] noreturn:[Quaternion_set]
Quaternion_equal call:[fabs]
Quaternion_fprint call:[fprintf] noreturn:[fprintf]
Quaternion_fromAxisAngle call:[assert,cos,sin]
Quaternion_toAxisAngle call:[acos,assert,sqrt]
Quaternion_fromXRotation call:[Quaternion_fromAxisAngle,assert] noreturn:[Quaternion_fromAxisAngle]
Quaternion_fromYRotation call:[Quaternion_fromAxisAngle,assert] noreturn:[Quaternion_fromAxisAngle]
Quaternion_fromZRotation call:[Quaternion_fromAxisAngle,assert] noreturn:[Quaternion_fromAxisAngle]
Quaternion_fromEulerZYX call:[assert,cos,sin]
Quaternion_toEulerZYX call:[asin,assert,atan2,copysign,fabs] noreturn:[asin,atan2,copysign]
Quaternion_conjugate call:[assert]
Quaternion_norm call:[assert,sqrt] noreturn:[sqrt]
Quaternion_normalize call:[Quaternion_norm,Quaternion_set,assert] noreturn:[Quaternion_set]
Quaternion_multiply call:[assert]
Quaternion_rotate call:[assert]
Quaternion_slerp call:[Quaternion_copy,acos,fabs,sin,sqrt]
