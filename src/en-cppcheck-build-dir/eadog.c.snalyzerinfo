lcd_get_position_page global:[lcd_current_page]
lcd_get_position_column global:[lcd_current_column]
ReSet_SetLow call:[DIS_RESET_Clear,wait_lcd_done] noreturn:[DIS_RESET_Clear]
ReSet_SetHigh call:[DIS_RESET_Set,wait_lcd_done] noreturn:[DIS_RESET_Set]
RS_SetLow call:[DIS_MODE_Clear,wait_lcd_done] noreturn:[DIS_MODE_Clear]
RS_SetHigh call:[DIS_MODE_Set,wait_lcd_done] noreturn:[DIS_MODE_Set]
CSB_SetLow call:[DIS_CS_Clear,wait_lcd_done] noreturn:[DIS_CS_Clear]
CSB_SetHigh call:[DIS_CS_Set,wait_lcd_done] noreturn:[DIS_CS_Set]
SPI1_Exchange8bit call:[SPI1_Write,wait_lcd_done] noreturn:[SPI1_Write]
SPI1_ExchangeBuffer call:[SPI1_Write,wait_lcd_done] noreturn:[SPI1_Write]
wdtdelay global:[NOPER]
init_display call:[CSB_SetHigh,send_lcd_cmd,send_lcd_cmd_long,wdtdelay] noreturn:[wdtdelay]
send_lcd_data call:[CSB_SetLow,SPI1_Exchange8bit,wdtdelay] noreturn:[SPI1_Exchange8bit]
send_lcd_cmd call:[CSB_SetLow,SPI1_Exchange8bit,wdtdelay] noreturn:[wdtdelay]
send_lcd_cmd_long call:[CSB_SetLow,SPI1_Exchange8bit,wdtdelay] noreturn:[wdtdelay]
eaDogM_WriteChr call:[send_lcd_data] noreturn:[send_lcd_data]
eaDogM_WriteCommand call:[send_lcd_cmd] noreturn:[send_lcd_cmd]
eaDogM_SetPos call:[eaDogM_WriteCommand] noreturn:[eaDogM_WriteCommand]
eaDogM_ClearRow call:[eaDogM_SetPos,eaDogM_WriteChr] noreturn:[eaDogM_WriteChr]
eaDogM_WriteString call:[CSB_SetLow,SPI1_Write,strlen] noreturn:[SPI1_Write]
eaDogM_WriteStringAtPos call:[OledPutString,OledSetCursor] noreturn:[OledPutString]
eaDogM_WriteIntAtPos call:[eaDogM_WriteChr,eaDogM_WriteCommand] noreturn:[eaDogM_WriteChr]
eaDogM_WriteByteToCGRAM call:[eaDogM_SetPos,eaDogM_WriteChr,eaDogM_WriteCommand] noreturn:[eaDogM_SetPos]
